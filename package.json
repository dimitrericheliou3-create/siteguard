{
  "name":"siteguard","version":"1.0.0","private":true,"type":"module",
  "scripts":{
    "dev":"wrangler pages dev public",
    "dev:monitor":"wrangler dev --config monitor-worker/wrangler.toml",
    "deploy:pages":"wrangler pages deploy public --project-name siteguard",
    "deploy:monitor":"wrangler deploy --config monitor-worker/wrangler.toml",
    "db:create":"wrangler d1 create siteguard-db",
    "db:migrate:local":"wrangler d1 execute siteguard-db --local --file=./schema.sql",
    "db:migrate:remote":"wrangler d1 execute siteguard-db --remote --file=./schema.sql",
    "test":"node --test"
  },
  "devDependencies":{"wrangler":"^4.40.0"}
}